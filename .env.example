PORT=4000
MONGODB_URI="mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/college_saas?retryWrites=true&w=majority"
# Generate these. Do not copy them from here, from a teammate, or from another
# environment — and never commit a real one.
#
#     openssl rand -base64 48
#
# Sessions are HS256 JWTs, so the signing key *is* authentication: anyone who
# holds it can mint a session for any college, or for a Super Admin, without
# guessing a password. Both services must carry the same SESSION_SECRET, since
# one signs the cookie and the other verifies it.
#
# This file previously carried working placeholder values, and a production
# deployment was found running them. `src/lib/secret-hygiene.ts` now refuses to
# start on any key that has appeared here, so filling these in with a literal
# will fail the deploy rather than quietly ship an open door.
SESSION_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL="admin@xite.co.in"
# The first Super Admin's password, used once at bootstrap. Generate it the
# same way and change it after the first sign-in.
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://admin.xite.co.in,https://xite.co.in"
APP_URL="https://xite.co.in"
ROOT_DOMAIN="xite.co.in"
AUTH_DISABLED=false
OPEN_ACCESS_SUBDOMAIN=greenfield

# Scopes the session cookie so admin.xite.co.in and api.xite.co.in share it.
# Leave unset locally, where everything is on localhost and host-only works.
SESSION_COOKIE_DOMAIN=".xite.co.in"

# Rate limiting is ON unless this is exactly "false". Listed so its state is
# visible; there is no reason to set it outside a load test.
ENABLE_RATE_LIMIT=true

# Proxy hops to believe for X-Forwarded-For. 1 behind Traefik, unset locally.
TRUST_PROXY=1

# Reference-data seeding on boot. Off by default — it writes to the database,
# and a container restart should not be a data migration.
SEED_ON_START=false
RESEND_API_KEY="re_123456789"
MAIL_FROM="noreply@xite.co.in"
# Gemini API key for AI Fix & Responsive feature. Server-side only — never expose to the browser.
GEMINI_API_KEY=your-gemini-api-key-here
