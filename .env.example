# Copy to .env for local development, or set these in Dokploy's dashboard
# (Application -> Environment) for deployment. NEVER commit a real .env.
#
# Every value below is a PLACEHOLDER. Replace all of them.

# =============================================================================
# DATABASE  (required)
# =============================================================================
# OPTIONAL. Leave this unset to use the Postgres container that the default
# docker-compose.yml brings up. Set it to point at a managed cloud database
# instead — keep `?sslmode=require`; TLS is negotiated automatically for any
# non-local host and verified against the system CA store.
#
#   Neon      postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/college_saas?sslmode=require
#   Supabase  postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#   Railway   postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require
#
# Prefer the provider's POOLED / connection-pooler host when it offers one.
#
# NEVER use `localhost` for a deployed app — inside a container that resolves
# to the container itself, not your machine.
# ---------------------------------------------------------------------------
# LEAVE COMMENTED OUT to use the Postgres container from docker-compose.yml.
#
# Uncomment only once you have a real connection string. If this is left as an
# unfilled placeholder, scripts/start.mjs ignores it and uses the bundled
# database instead (logging loudly), rather than failing against a hostname
# that cannot resolve — but only when POSTGRES_PASSWORD is set, i.e. when the
# bundled Postgres exists. With docker-compose.cloud-db.yml there is nothing to
# fall back to and a placeholder still breaks the app.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/college_saas?sslmode=require

# Max concurrent connections this container opens. Keep it comfortably under
# your provider's limit (Neon free tier pooled: ~100; Supabase free: ~60).
DATABASE_POOL_MAX=10

# Only set to "true" if your provider uses a self-signed certificate. It turns
# off certificate verification, which removes protection against MITM.
# DATABASE_SSL_NO_VERIFY=false

# =============================================================================
# APPLICATION  (required)
# =============================================================================
# Signs the session cookie. Must be at least 32 characters or the app refuses
# to start. Generate one with:  openssl rand -base64 32
#
# MUST be byte-identical to the frontend's SESSION_SECRET. This service mints
# the session at sign-in and the frontend verifies it on every guarded render,
# so a mismatch means sign-in succeeds and the page after it says signed out —
# with nothing in either log to say why.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# The port this API listens on. The frontend's dev server takes 3000, so a
# local run needs something else; in Docker the compose file sets it.
PORT=4000

# Which origins may call this API, comma separated.
#
# NOT optional in practice: the session cookie rides on these requests, and a
# browser refuses a wildcard origin alongside credentials — so an unset value
# means every authenticated call from the frontend fails CORS. Name the
# frontend's origin exactly, scheme and port included.
CORS_ORIGINS=http://localhost:3000

# Set ONLY when this service and the frontend are subdomains of one parent.
# It is what lets one login cover both: without it the cookie is scoped to
# api.xite.co.in alone, and the frontend — which renders every guarded page
# server-side — never sees it.
#
# Leave it unset locally, where both are on localhost and a Domain of
# `.xite.co.in` is simply dropped by the browser.
# SESSION_COOKIE_DOMAIN=.xite.co.in

# Where uploaded images are written. Must be a mounted volume in deployment, or
# every image uploaded disappears on the next redeploy.
# UPLOAD_DIR=/app/public/uploads

# Where the app lives, for links this service puts in an email. An activation
# link opens a page on the frontend, not an endpoint here.
#
# OPTIONAL. Derived from the first entry in CORS_ORIGINS when unset, on the same
# reasoning as the cookie Domain above: the browser already forces that list to
# be correct, so it is the one origin here that cannot quietly be wrong. Set it
# only when the first allowed origin is not where invitations should point — an
# admin panel listed first, say.
# APP_URL=https://xite.co.in

# =============================================================================
# EMAIL  (required for the access-request flow)
# =============================================================================
# The approval email. Without both of these, approving a request still succeeds
# and still mints a valid invite — it just cannot deliver it. The endpoint says
# so in its response (`delivered: false`) and /api/health reports
# `mailer: "not configured"`, because the alternative is a person who never got
# an email and no way for them to tell you.
#
# Outside production, a missing transport prints the activation URL to the log
# instead, so the flow can be walked with no mail account at all. In production
# it deliberately does NOT print it — stdout gets shipped somewhere, and a
# credential in a log aggregator is a credential in a place nobody locked.
#
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address. MUST be on a domain verified with Resend, or every send is
# refused with a 403 that looks like a bad key.
# MAIL_FROM=XITE <no-reply@xite.co.in>

# =============================================================================
# GOOGLE  (required only for activation via Google)
# =============================================================================
# The SAME client id as the frontend's. Public — it appears in every
# authorization URL a browser follows — so there is no secret here and none is
# needed: this service verifies id_token signatures, it never exchanges a code.
# GOOGLE_CLIENT_SECRET deliberately does not belong here; the exchange stays in
# xite-F, which is where the callback lives.
#
# Without this, POST /api/v1/activate/google answers 503 and the activation page
# should offer the password path only. Activation by password is unaffected.
#
# It is what pins the `audience` claim when verifying. A token Google signed for
# somebody else's application is still a valid Google token — pinning the
# audience is the check that rejects it, so a wrong value here is not a
# cosmetic mismatch.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# =============================================================================
# OPEN ACCESS  (no sign-in)
# =============================================================================
# Set to "true" to remove authentication entirely: "/" goes straight to the
# editor, and /login and /signup bounce there too. For a single-tenant install
# where the deployment itself is the access control.
#
# READ THIS BEFORE ENABLING IT ON A PUBLIC DOMAIN. Every visitor is treated as
# the owner, so anyone who reaches the URL can edit and publish the site, and
# unpublished drafts are visible to them as well. There is no password to get
# wrong because there is no password.
#
# The first visit adopts the college that already exists, or creates one when
# the database is empty. The two names below only apply to that created one.
# AUTH_DISABLED=false
# OPEN_ACCESS_SUBDOMAIN=main
# OPEN_ACCESS_COLLEGE_NAME=My College

# =============================================================================
# BUNDLED POSTGRES  (default docker-compose.yml)
# =============================================================================
# The default stack runs its own Postgres container, so no cloud account is
# needed. Only the password is required — user and database name are fixed as
# `collegeadmin` / `college_saas`.
#
# If you set DATABASE_URL above, it takes precedence and this is unused.
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Migrations are retried on start; after this many failures the app serves
# anyway so the error is visible rather than crash-looping behind a 502.
# MIGRATE_RETRIES=5
# MIGRATE_FAIL_FAST=false

# After migrating, the reference data a fresh database needs (templates,
# section variants, palettes, font packs) is seeded. Migrations only create
# tables, so without this the template gallery is empty. It is idempotent and
# never touches a college's edited content. Set to "false" to skip it.
# SEED_ON_START=true

# The deployed seed omits the demo college and its README-published login.
# Only set this to "true" if you deliberately want the demo data deployed.
# SEED_DEMO_COLLEGE=false

# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# For a Postgres running on your own machine, use this instead of the cloud URL
# above (no TLS is attempted for localhost).
#
# THIS LINE IS FOR YOUR MACHINE ONLY — never paste it into a deployment
# dashboard. In a container `localhost` is the container itself, so nothing is
# listening and every page fails with ECONNREFUSED against a host that looks
# fine. scripts/start.mjs detects this when running in a container and falls
# back to the bundled Postgres, but only when POSTGRES_PASSWORD is set.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_saas?schema=public
