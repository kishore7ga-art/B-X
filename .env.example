PORT=4000
MONGODB_URI="mongodb+srv://<USERNAME>:<PASSWORD>@xitedb.uk7epss.mongodb.net/college_saas?retryWrites=true&w=majority&appName=xitedb"
SESSION_SECRET="super-secret-session-key-for-xite-local-dev-32chars"
ADMIN_SESSION_SECRET="super-secret-admin-session-key-32chars"
ADMIN_BOOTSTRAP_EMAIL="admin@xite.co.in"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-secure-admin-password"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://admin.xite.co.in,https://xite.co.in"
APP_URL="https://xite.co.in"
ROOT_DOMAIN="xite.co.in"
AUTH_DISABLED=false
OPEN_ACCESS_SUBDOMAIN=greenfield

# Scopes the session cookie so admin.xite.co.in and api.xite.co.in share it.
# Leave unset locally, where everything is on localhost and host-only works.
SESSION_COOKIE_DOMAIN=".xite.co.in"

# Rate limiting is ON unless this is exactly "false". Listed so its state is
# visible; there is no reason to set it outside a load test.
ENABLE_RATE_LIMIT=true

# Proxy hops to believe for X-Forwarded-For. 1 behind Traefik, unset locally.
TRUST_PROXY=1

# Reference-data seeding on boot. Off by default — it writes to the database,
# and a container restart should not be a data migration.
SEED_ON_START=false
RESEND_API_KEY="re_123456789"
MAIL_FROM="noreply@xite.co.in"
# Gemini API key for AI Fix & Responsive feature. Server-side only — never expose to the browser.
GEMINI_API_KEY=your-gemini-api-key-here
