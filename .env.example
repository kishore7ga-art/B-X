PORT=4000
MONGODB_URI="mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/college_saas?retryWrites=true&w=majority"
# Generate these. Do not copy them from here, from a teammate, or from another
# environment — and never commit a real one.
#
#     openssl rand -base64 48
#
# Sessions are HS256 JWTs, so the signing key *is* authentication: anyone who
# holds it can mint a session for any college, or for a Super Admin, without
# guessing a password. Both services must carry the same SESSION_SECRET, since
# one signs the cookie and the other verifies it.
#
# This file previously carried working placeholder values, and a production
# deployment was found running them. `src/lib/secret-hygiene.ts` now refuses to
# start on any key that has appeared here, so filling these in with a literal
# will fail the deploy rather than quietly ship an open door.
SESSION_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL="admin@xite.co.in"
# The first Super Admin's password, used once at bootstrap. Generate it the
# same way and change it after the first sign-in.
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://admin.webxite.org,https://webxite.org"
APP_URL="https://webxite.org"
ROOT_DOMAIN="webxite.org"
AUTH_DISABLED=false
OPEN_ACCESS_SUBDOMAIN=greenfield

# Scopes the session cookie so admin.webxite.org and api.webxite.org share it.
# Leave unset locally, where everything is on localhost and host-only works.
SESSION_COOKIE_DOMAIN=".webxite.org"

# What a tenant is told to point their own domain at, on the domain settings
# screen. Both are optional and both default sensibly: the CNAME target falls
# back to `sites.<ROOT_DOMAIN>`, and no A record is offered at all unless an
# apex IP is set — an apex domain cannot carry a CNAME, and inventing an
# address would send tenants somewhere that is not us.
#
# Set CUSTOM_DOMAIN_APEX_IP to this deployment's public IP if you want tenants
# to be able to connect an apex domain (college.edu rather than www.college.edu).
# CUSTOM_DOMAIN_CNAME_TARGET=sites.webxite.org
# CUSTOM_DOMAIN_APEX_IP=

# Rate limiting is ON unless this is exactly "false". Listed so its state is
# visible; there is no reason to set it outside a load test.
ENABLE_RATE_LIMIT=true

# Proxy hops to believe for X-Forwarded-For. 1 behind Traefik, unset locally.
TRUST_PROXY=1

# Reference-data seeding on boot. Off by default — it writes to the database,
# and a container restart should not be a data migration.
SEED_ON_START=false
RESEND_API_KEY="re_123456789"
# Must be on a domain verified with Resend, or every send 403s. Verify
# webxite.org in Resend before switching this over.
MAIL_FROM="noreply@webxite.org"
# GOOGLE SIGN-IN
#
# The client id only, and deliberately not the secret. This service verifies
# Google id_tokens against Google's public keys — see src/google-identity.ts —
# and a signature check needs the client id as the audience and nothing else.
# Obtaining a token is xite-F's job, so GOOGLE_CLIENT_SECRET belongs there and
# must never be set here.
#
# Must be the SAME client id xite-F uses, or activation-by-Google rejects every
# token as issued to a different application.
#
# Unset, Google-based activation refuses rather than trusting the caller's
# claimed email address. That refusal is the security boundary of the whole
# invite flow, so it fails closed on purpose.
GOOGLE_CLIENT_ID=

# Gemini API key for AI Fix & Responsive feature. Server-side only — never expose to the browser.
GEMINI_API_KEY=your-gemini-api-key-here
