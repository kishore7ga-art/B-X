// College Website Template Platform — multi-tenant schema.
// Mirrors Section 5 of the project spec. Table/column names are snake_case via @map
// so the physical schema reads exactly like the spec draft.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CollegeStatus {
  DRAFT
  PUBLISHED
}

/// Section TYPES the platform knows how to render. Spec Section 3.
enum SectionType {
  HERO
  ABOUT
  COURSES
  ADMISSIONS
  FACULTY
  FACILITIES
  GALLERY
  EVENTS
  CONTACT
  FOOTER
  PLACEMENTS
  TESTIMONIALS
  DOWNLOADS
  FEES
  ACCREDITATION
  /// Added with the admin section library. The first three are ordinary typed
  /// sections that were simply missing; `CUSTOM` is not.
  HEADER
  FEATURES
  CTA
  /// The one section type whose content is pasted markup rather than fields.
  ///
  /// Every other type is a Zod schema and a React component, which is what makes
  /// the ↻ swap, the form editor and `personalize()` possible — content survives
  /// a design change because every variant of a type reads identical props. A
  /// blob of HTML has no props, so none of that applies to it.
  ///
  /// It exists anyway because an admin needs somewhere to put a one-off block
  /// without waiting for a component to ship, and confining that to one type is
  /// what keeps it from costing the other fourteen. Sections of this type are
  /// sanitised on save and again on render, and are the only reason this codebase
  /// has a sanitiser at all.
  CUSTOM
}

model College {
  id             String        @id @default(cuid())
  name           String
  subdomain      String        @unique
  customDomain   String?       @unique @map("custom_domain")
  templateId     String?       @map("template_id")
  themePaletteId String?       @map("theme_palette_id")
  themeFontId    String?       @map("theme_font_id")
  status         CollegeStatus @default(DRAFT)
  /// Whether a signup with no college may claim this one.
  ///
  /// signup() adopts the oldest college that has no users, which is how an
  /// open-access install keeps its work when someone finally registers. Once a
  /// Super Admin can delete the last owner of a college deliberately, that same
  /// path would hand a stranger somebody else content and their published site.
  /// Deleting an owner clears this; reassigning ownership is a decision, not a
  /// race won by the next person to sign up.
  adoptable      Boolean       @default(true)
  /// What kind of institution this is, from onboarding — see
  /// src/lib/college-types.ts for the values and the template each opens with.
  ///
  /// Nullable on purpose. Every college that exists today predates onboarding,
  /// and backfilling a guess would be inventing an answer nobody gave. Code
  /// reading this must treat null as "not asked yet", not as an error.
  ///
  /// A String rather than an enum: adding an institution type should be a seed
  /// change, not a migration, and the set is expected to grow.
  collegeType    String?       @map("college_type")
  /// A showcase site for a template, seeded and published so the gallery has
  /// something real to link to. Never handed to a visitor as their own site:
  /// open-access mode skips these when adopting a college, or the first person
  /// to arrive on a fresh install would be editing the demo.
  isDemo         Boolean       @default(false) @map("is_demo")
  createdAt      DateTime      @default(now()) @map("created_at")

  template     Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  themePalette ThemePalette? @relation(fields: [themePaletteId], references: [id], onDelete: SetNull)
  themeFont    ThemeFont?    @relation(fields: [themeFontId], references: [id], onDelete: SetNull)

  sections CollegeSection[]
  pages    Page[]
  users    User[]

  @@map("colleges")
}

/// Login accounts. A college can have several staff accounts; each account
/// belongs to exactly one college, which is the tenant boundary.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  collegeId    String     @map("college_id")
  /// Whether this account may sign in. Checked by both login paths.
  ///
  /// `ACTIVE` is the default, and that direction matters: every user that
  /// exists today predates the access-request flow, and a column defaulting to
  /// anything else would mark all of them unable to sign in the moment the
  /// login gate lands — a lockout caused by a migration, reported as "wrong
  /// password". Same reasoning as `College.collegeType` being nullable.
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  accessRequest AccessRequest?

  @@index([collegeId])
  @@map("users")
}

/// Whether an account may sign in.
///
/// Deliberately two values, not three. The guide this flow came from has an
/// `invited` state for "user row created, waiting to activate" — that state does
/// not exist here, because a `users` row is not written until activation
/// succeeds. Until then the pending account is an `access_requests` row and
/// nothing else, which is the whole point of that table.
///
/// So there is no `INVITED`: nothing could ever set it, and an enum value no
/// code path can produce is a question somebody has to answer again in a year.
/// If approval is ever changed to create the user up front, it comes back.
enum UserStatus {
  ACTIVE
  /// Access revoked by a Super Admin. The row is kept so the college keeps its
  /// owner record and the audit log keeps its subject.
  DISABLED
}

model Template {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  thumbnailUrl String?   @map("thumbnail_url")
  demoUrl      String?   @map("demo_url")
  /// Code or markup content of the template, uploaded as a file or saved manually.
  code         String?   @map("code")
  /// When this template stopped being offered to new colleges.
  ///
  /// Not a delete. Section rows cascade from Template, and CollegeSection rows
  /// cascade from Section — so removing a template row would take the content
  /// of every college using it with it, which is the opposite of retiring a
  /// design. Archiving hides it from the picker and leaves every existing site
  /// untouched. A real delete is only offered when no college uses it.
  archivedAt   DateTime? @map("archived_at")

  /**
   * Whether users may pick it yet. A different question from `archivedAt`.
   * These are two axes, not one, and collapsing them would lose a state the
   * assembly screen needs: `isPublished` is draft-versus-live — an admin has
   * started composing this and is not finished — while `archivedAt` is
   * live-versus-retired, a template that was offered and no longer is. A template
   * can be unpublished and never archived (still being built), or published and
   * archived (was offered, withdrawn).
   * Defaults false, so a half-assembled template cannot appear in the gallery
   * merely because a row exists. The five that already exist are backfilled to
   * true by the migration — they are live, and a flag added underneath them must
   * not retire them.
   */
  isPublished Boolean @default(false) @map("is_published")

  /// Who assembled it, with the email copied in for the same reason as
  /// `SectionVariant.createdByEmail`.
  createdById    String?  @map("created_by_id")
  createdByEmail String?  @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sections  Section[]
  colleges  College[]

  @@index([isPublished, archivedAt])
  @@map("templates")
}

/// Master list of section types available in a template.
model Section {
  id             String      @id @default(cuid())
  templateId     String      @map("template_id")
  sectionType    SectionType @map("section_type")
  defaultOrder   Int         @map("default_order")
  isRequired     Boolean     @default(false) @map("is_required")
  /// Starter copy for this section in this template's voice — the same content
  /// its demo site shows.
  ///
  /// A college that has just picked a design should see the template working,
  /// not five headings over empty space. Provisioning used a generic stub
  /// ("About Us", "Courses"), so every new site opened looking broken while the
  /// gallery demo beside it looked finished.
  defaultContent Json?       @map("default_content")

  /// Which library variant this template leads with for this section type.
  ///
  /// This column is the whole reason de-duplicating the variant library did not
  /// flatten all five templates into one look. `sortOrder` used to do this job:
  /// variants were stored per template slot, so each template could order its own
  /// copies and lead with a different one. Sharing the library makes `sortOrder`
  /// global, and a global order means every template provisions the same variant.
  ///
  /// So the choice moves here, onto the join, which is where it always belonged —
  /// "which design does Meridian open with" is a fact about Meridian, not about
  /// the design. Null means fall back to the library's own `sortOrder`.
  defaultVariantId String? @map("default_variant_id")

  template        Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  defaultVariant  SectionVariant?  @relation("SectionDefaultVariant", fields: [defaultVariantId], references: [id], onDelete: SetNull)
  collegeSections CollegeSection[]

  @@unique([templateId, sectionType])
  @@map("sections")
}

/// Design variants cycled through by the editor's refresh (↻) button.
model SectionVariant {
  id           String      @id @default(cuid())
  /**
   * What kind of section this design is for.
   * Replaces `sectionId`, and that swap is the point of this change. A variant
   * used to belong to one template's slot, so the same 33 designs were stored 150
   * times — once per template that offered them — and an admin adding a design had
   * to add it five times. Keying on the type instead makes the library shared,
   * which is what `sortOrder`'s own comment already claimed was true: "every
   * template still offers the whole variant library to the ↻ button".
   */
  sectionType  SectionType @map("section_type")
  variantName  String      @map("variant_name")
  /// Unique now that the library is shared — one row per design, where before
  /// there were five rows carrying the same key.
  componentKey String      @unique @map("component_key")
  /**
   * The library's own order, and now only a fallback.
   * It used to carry two jobs at once: how the ↻ button orders designs, and which
   * one each template opens with. The second was only possible because rows were
   * per-template — sharing them makes this global, so it has moved to
   * `Section.defaultVariantId`. What is left is the honest half: a stable order
   * for the picker, used as the lead when a template slot names no preference.
   */
  sortOrder    Int         @default(0) @map("sort_order")

  /// Whether the ↻ button and the assembly screen still offer it.
  ///
  /// Retired rather than deleted, for the same reason `Template.archivedAt` is:
  /// `college_sections.variant_id` points here, so removing a row would either
  /// cascade into live sites or fail outright. A retired variant keeps rendering
  /// for every college already using it and stops being offered to anyone new.
  isActive Boolean @default(true) @map("is_active")

  /**
   * Pasted markup, for `CUSTOM` variants only, already sanitised.
   * Null for every other type, where the design is a registered React component
   * named by `componentKey` and there is nothing here to store. This column is
   * what a `CUSTOM` section is copied *from*: adopting one writes a sanitised copy
   * into `college_sections.content`, so an admin editing this afterwards cannot
   * reach into a site that already took it.
   * Sanitised on the way in and again on the way out. Storing it clean is not
   * enough by itself — sanitiser rules change, and a section saved before a rule
   * existed must not be exempt from it later.
   */
  defaultHtml String? @map("default_html")

  /// Who added it. `createdByEmail` is copied in rather than read through the
  /// relation, for the reason `AuditLog.actorEmail` is: `SetNull` must not turn
  /// "who put this on every college site" into a blank.
  createdById    String?  @map("created_by_id")
  createdByEmail String?  @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdBy       AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  collegeSections CollegeSection[]
  /// Template slots that lead with this variant.
  leadsSections   Section[]        @relation("SectionDefaultVariant")

  @@index([sectionType, isActive])
  @@map("section_variants")
}

/// Each college's actual configured sections. `content` is validated in app code
/// by a per-section-type Zod schema (see src/lib/sections/schemas.ts).
model CollegeSection {
  id           String    @id @default(cuid())
  collegeId    String    @map("college_id")
  sectionId    String    @map("section_id")
  variantId    String    @map("variant_id")
  /// Which page this section renders on. Spec Section 5 derives a page's section
  /// list "from college_sections.display_order per page", which needs this link.
  pageId       String?   @map("page_id")
  displayOrder Int       @map("display_order")
  isVisible    Boolean   @default(true) @map("is_visible")
  content      Json      @default("{}")
  /// When this section's content was last written. Drives the editor's "Saved
  /// 14:32" line, which is what makes an autosaving form trustworthy: without a
  /// timestamp, "Saved" is indistinguishable from a form that never saved.
  ///
  /// There is deliberately no `save_status` column beside it. A row cannot be
  /// "saving" — that is one browser's in-flight state, not a fact about the
  /// data — and it can never be "error", because the write that would record
  /// the error is the write that just failed. Both live in the client.
  lastSavedAt  DateTime? @map("last_saved_at")

  college College                 @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  section Section                 @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  variant SectionVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  page    Page?                   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  history CollegeSectionHistory[]

  @@index([collegeId, pageId, displayOrder])
  @@map("college_sections")
}

/// One snapshot of a section's content, written on every save that actually
/// changed something.
///
/// Autosave without history is only half a safety net: it guarantees work is
/// never lost to forgetting to save, and guarantees nothing about work lost to
/// a bad edit. This is the other half — the timeline behind "Restore previous
/// version".
///
/// Pruned to the newest RETAINED_VERSIONS rows per section on insert. A
/// two-second debounce across every action type produces snapshots faster than
/// anyone will ever read them, and unbounded JSONB copies of a page's content
/// is a storage bill, not a feature.
model CollegeSectionHistory {
  id               String   @id @default(cuid())
  collegeSectionId String   @map("college_section_id")
  contentSnapshot  Json     @map("content_snapshot")
  savedAt          DateTime @default(now()) @map("saved_at")
  /// What caused this save: typing / drag / color / font / image / delete /
  /// resize / section_update / restore.
  saveTrigger      String   @map("save_trigger")

  collegeSection CollegeSection @relation(fields: [collegeSectionId], references: [id], onDelete: Cascade)

  @@index([collegeSectionId, savedAt])
  @@map("college_sections_history")
}

model ThemePalette {
  id     String @id @default(cuid())
  name   String @unique
  /// { primary, secondary, accent, dark, light }
  colors Json

  colleges College[]

  @@map("theme_palettes")
}

model ThemeFont {
  id          String @id @default(cuid())
  name        String @unique
  headingFont String @map("heading_font")
  bodyFont    String @map("body_font")

  colleges College[]

  @@map("theme_fonts")
}

model Page {
  id        String @id @default(cuid())
  collegeId String @map("college_id")
  slug      String
  title     String
  navOrder  Int    @default(0) @map("nav_order")

  /// Per-page SEO, set from the editor's page tools.
  ///
  /// Separate nullable columns rather than one Json blob: these four are fixed,
  /// typed, and rendered straight into <head>, so a shape that has to be parsed
  /// and re-validated on every request buys nothing. All nullable — every page
  /// that exists predates them, and null means "fall back to the page title",
  /// not "unset and broken".
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  ogImage         String? @map("og_image")
  /// Overrides the URL search engines should treat as canonical. Defaults to
  /// the page's own slug when empty.
  canonicalSlug   String? @map("canonical_slug")

  college  College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sections CollegeSection[]

  @@unique([collegeId, slug])
  @@map("pages")
}

/// A Super Admin of the platform itself — not a college owner.
///
/// Deliberately its own table rather than a flag on `users`. A role column
/// means one bug in a query is the difference between a college owner and
/// somebody who can delete every college; a separate table, a separate cookie
/// and a separate secret means a college session cannot be mistaken for this
/// one by any code path, because there is no path from one to the other.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  /// Base32 TOTP secret. Nullable so an account can be created before it is
  /// enrolled, but sign-in refuses to complete while it is null.
  totpSecret   String?   @map("totp_secret")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  auditEntries     AuditLog[]
  reviewedAccess   AccessRequest[]
  createdVariants  SectionVariant[]
  createdTemplates Template[]

  @@map("admin_users")
}

/// What a Super Admin did, and to what.
///
/// `actorEmail` is copied in rather than read through the relation, because the
/// question this table exists to answer is asked *after* something has gone
/// wrong — quite possibly after the admin account involved was itself removed.
/// A log whose rows become anonymous when an account is deleted is not a log.
///
/// `SetNull` on the relation for the same reason: losing the actor must never
/// take the record of what they did with it.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorEmail String   @map("actor_email")
  /// Machine-readable, e.g. `template.archive`, `user.delete`.
  action     String
  /// What was acted on: `template`, `user`, `college`.
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  /// One line, written for a human reading this in six months.
  summary    String
  /// Anything worth keeping that does not deserve a column — counts, the
  /// previous value, the confirmation the operator was shown.
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Somebody asking for access, before they are anybody.
///
/// Its own table rather than a `users` row with a flag, for the same reason
/// `AdminUser` is its own table: a request has no tenant, no password and no
/// right to sign in, and the cheapest way to guarantee it can never
/// accidentally acquire them is for it not to be a user at all. Nothing is
/// written to `users` until activation succeeds.
///
/// That answers the question the schema could not: a `College` is created at
/// activation, alongside the user, by the same adopt-or-create path that
/// `signup()` already uses. Approving a request allocates no subdomain — an
/// approval nobody acts on leaves a row here and nothing else, rather than an
/// orphan college squatting a name forever.
model AccessRequest {
  id           String              @id @default(cuid())
  name         String
  /// Not unique, and not a foreign key. Somebody rejected once may apply again,
  /// and the address is not an account until activation makes it one. Uniqueness
  /// is enforced where it means something — on `users.email`.
  email        String
  organization String?
  message      String?
  status       AccessRequestStatus @default(PENDING)
  createdAt    DateTime            @default(now()) @map("created_at")

  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id")
  /// Copied in rather than read through the relation, exactly as
  /// `AuditLog.actorEmail` is and for the same reason: "who approved this" is
  /// asked after something has gone wrong, possibly after that admin account was
  /// removed. `SetNull` below must not take the answer with it.
  reviewedByEmail String?   @map("reviewed_by_email")

  /// SHA-256 of the invite token, never the token itself.
  ///
  /// The raw value exists in exactly two places — the email that was sent, and
  /// the URL the recipient clicks. A readable column here would mean anybody
  /// with database access could activate somebody else's account, which is the
  /// one thing this token is supposed to prevent.
  ///
  /// Nulled on use rather than kept with a flag, so single-use is a property of
  /// the schema rather than a check somebody has to remember to write.
  inviteTokenHash      String?   @unique @map("invite_token_hash")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")

  /// Set at activation, not at approval — null here means "approved, not yet
  /// acted on". Unique because one request may only ever mint one account.
  createdUserId String? @unique @map("created_user_id")

  reviewedBy  AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  createdUser User?      @relation(fields: [createdUserId], references: [id], onDelete: SetNull)

  @@index([email])
  /// The admin list is "pending, newest first", which this serves as one scan.
  @@index([status, createdAt])
  @@map("access_requests")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A key this service generated for itself because nothing supplied one.
///
/// Exists for exactly one reason: `ADMIN_SESSION_SECRET` used to be a hard
/// requirement, and a deployment that had not set it answered 503 on every admin
/// route with no way to fix it from inside the running system. That is a correct
/// refusal and a terrible one to be stuck behind — the panel is the surface an
/// operator reaches for when something is wrong.
///
/// The env variable still wins whenever it is set, and this is never a fallback
/// to `SESSION_SECRET`: the separation that made the admin key its own variable
/// is the whole point, and reusing the app's key would quietly undo it. What
/// gets stored here is 48 fresh random bytes, once, so sessions survive a
/// restart rather than logging every admin out on deploy.
///
/// Anybody who can read this table can already read `admin_users.password_hash`
/// and write their own admin account, so it is not a new exposure.
model ServiceSecret {
  /// Stable identifier, e.g. `admin_session`. Not a description.
  name      String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_secrets")
}
